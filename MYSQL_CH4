Query 8: Using keyword
• rewrite query 4 using the “USING” keyword instead of “ON”
• result set will be the same
***************************************************************/
 SELECT staff_id, CONCAT(s.last_name, ' , ', s.first_name) AS staff_name, email, store_id, a.district, city, country
FROM staff s
    JOIN address a
        USING (address_id)
    JOIN city c1
        USING (city_id)
    JOIN country c2
        USING (country_id);   

