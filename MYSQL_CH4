Query 6: Left Outer Join
• write a query that produces the following output displaying all titles that have never been rented
• using a LEFTER OUTER JOIN
• sort by title
• tables: film, inventory, and rental
*******************************************************/
SELECT f.film_id, f.title, rental_id, rental_date
FROM film f LEFT JOIN inventory i
		ON f.film_id = i.film_id
	LEFT JOIN rental r
     ON i.inventory_id = r.inventory_id
WHERE r.rental_id IS NULL
AND r.rental_date IS NULL
ORDER BY title;
/****************************************************************
Query 7: Right Outer Join
• write a query that produces the following output displaying languages with no films
• using a RIGHT OUTER JOIN
• sort by language name
• tables: film, language
*************************************************************************/
SELECT f.film_id, f.title, l.language_id, l.name
FROM film f
	RIGHT JOIN language l
		ON f.language_id = l.language_id
WHERE f.film_id IS NULL
	AND f.title IS NULL
ORDER BY l.name;
